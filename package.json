{
  "name": "cf-search-mcp",
  "version": "0.1.0",
  "description": "Cloudflare Workers search service: fallback multi-engine search, wiki search, web fetch and MCP over HTTP",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run typecheck && node esbuild.config.mjs",
    "typecheck": "tsc --noEmit",
    "dev": "wrangler dev",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4",
    "@mozilla/readability": "^0.5.0",
    "linkedom": "^0.18.9",
    "turndown": "^7.2.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260702.1",
    "@types/turndown": "^5.0.6",
    "esbuild": "^0.24.0",
    "typescript": "^7.0.2",
    "wrangler": "^3.95.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
